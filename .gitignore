# Build artifacts
/9router-go
/9router-go-*
/SHA256SUMS.txt
*.exe
*.exe~
web/dist/
web/.dist-stamp
_site/

# Test binaries
*.test
*.out

# Logs
*.log
/tmp/*.log

# Data directory
.9router/
data/

# Local demo gateway: its SQLite data dir, engine key and captured streams. The
# key alone is enough to talk to the running gateway as a client, so none of it
# belongs in a commit.
.demo/

# Local overrides
docker-compose.local.yml

# Environment
.env

# Editor / OS
.idea/
.vscode/
.DS_Store
graphify-out
node_modules/
web/node_modules/
stitch-screens/
stitch-screenshots/

# Git worktrees — each is a nested repo, so `git add -A` will happily stage
# them as embedded gitlinks. A worktree caught in a commit has to be undone
# with `git rm --cached` before it reaches the remote.
.worktrees/
.smoke-data/
# 引擎二进制与版本落盘是 build.sh 每次重新生成的产物（build.sh 步骤 5），
# 入库只会让每次发布推送携带 15MB blob（镜像代理 413 拒收）——ADR-0008
module/bin/9router-go
module/etc/engine-version
# IDE local data
.workbuddy-ai/

# build-dnsfwd.sh 的第三方源码缓存（mbedTLS 解包树，勿入库）
tools/third_party/
tools/dnsfwd

# A pasted browser-login credential for scripts/deepseek-web-live.sh. Never
# belongs in a commit, and `git add -A` would otherwise stage it silently.
.ds-token
